(IN-PACKAGE #:STATICL-USER)

(ASDF/OPERATE:LOAD-SYSTEM "staticl/format/spinneret")

(site "Custom site" :description "" :url "https://custom-site.ru/" :pipeline
 (list (load-content) (prev-next-links)
       (paginated-index :target-path "" :page-title-fn
        (lambda (num)
          (if (< 1 num)
              (format nil "Страница ~A" num)
              "")))
       (rss :target-path "rss.xml") (atom :target-path "atom.xml")
       (tags-index :target-path "tags/") (sitemap))
 :theme *site-theme* :vars *site-vars*)
